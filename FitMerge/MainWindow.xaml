<Window x:Class="FitMerge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:FitMerge.Services"
        Title="{svc:Loc WindowTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="720" Width="1000" MinHeight="560" MinWidth="820"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="0,2,16,2"/>
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: file list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{svc:Loc FilesHeader}" Style="{StaticResource SectionHeader}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="{svc:Loc AddButton}" Click="AddFiles_Click"/>
                <Button x:Name="RemoveButton" Content="{svc:Loc RemoveButton}" Margin="8,0,0,0" Click="RemoveFile_Click" IsEnabled="False"/>
            </StackPanel>
            <ListBox x:Name="FileList" Grid.Row="2"
                     SelectionChanged="FileList_SelectionChanged"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" Text="{svc:Loc DropHint}"
                       Opacity="0.6" FontSize="12" Margin="0,8,0,0"/>
        </Grid>

        <!-- Right column: preview, analysis, options, device, verification -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{svc:Loc PreviewHeader}" Style="{StaticResource SectionHeader}"/>
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="PreviewEmptyText" Text="{svc:Loc PreviewEmpty}" Opacity="0.6"/>
                            <Grid x:Name="PreviewGrid" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{svc:Loc LabelSport}" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValSport" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelStart}" Grid.Row="1" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValStart" Grid.Row="1" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelEnd}" Grid.Row="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValEnd" Grid.Row="2" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelDuration}" Grid.Row="3" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValDuration" Grid.Row="3" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelDistance}" Grid.Row="4" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValDistance" Grid.Row="4" Grid.Column="1" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelRecords}" Grid.Row="5" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValRecords" Grid.Row="5" Grid.Column="1" Style="{StaticResource DetailValue}"/>

                                <TextBlock Text="{svc:Loc LabelAvgHr}" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValAvgHr" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelMaxHr}" Grid.Row="1" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValMaxHr" Grid.Row="1" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelCalories}" Grid.Row="2" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValCalories" Grid.Row="2" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelLaps}" Grid.Row="3" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValLaps" Grid.Row="3" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelPauses}" Grid.Row="4" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValPauses" Grid.Row="4" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                                <TextBlock Text="{svc:Loc LabelTimer}" Grid.Row="5" Grid.Column="2" Style="{StaticResource DetailLabel}"/>
                                <TextBlock x:Name="ValTimer" Grid.Row="5" Grid.Column="3" Style="{StaticResource DetailValue}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <TextBlock Text="{svc:Loc AnalysisHeader}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="IssuesEmptyText" Text="{svc:Loc AnalysisNone}" Opacity="0.6"/>
                            <ItemsControl x:Name="IssuesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Icon}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{svc:Loc OptionsHeader}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{svc:Loc OverlapLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="OverlapCombo" SelectedIndex="0" MinWidth="260">
                                    <ComboBoxItem Content="{svc:Loc OverlapPreferFirst}"/>
                                    <ComboBoxItem Content="{svc:Loc OverlapPreferSecond}"/>
                                    <ComboBoxItem Content="{svc:Loc OverlapKeepAll}"/>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox x:Name="PauseCheck" Content="{svc:Loc PauseCheck}" IsChecked="True" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{svc:Loc DeviceHeader}" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                    <Border CornerRadius="8" Padding="16"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12" Text="{svc:Loc DeviceExplain}"/>
                            <CheckBox x:Name="DeviceOverrideCheck" Content="{svc:Loc DeviceOverrideCheck}"
                                      Checked="DeviceOverride_Changed" Unchecked="DeviceOverride_Changed"/>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{svc:Loc DeviceLabel}" VerticalAlignment="Center" Margin="0,0,12,0" Opacity="0.7"/>
                                <ComboBox x:Name="DeviceCombo" Grid.Column="1" IsEditable="True" IsEnabled="False"
                                          SelectionChanged="DeviceField_Changed" LostFocus="DeviceField_Changed"/>
                                <TextBlock Text="{svc:Loc SerialLabel}" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,12,0" Opacity="0.7"/>
                                <TextBox x:Name="SerialBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                         IsEnabled="False" LostFocus="DeviceField_Changed"/>
                            </Grid>
                            <TextBlock x:Name="DeviceHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.75"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="VerifyHeader" Text="{svc:Loc VerifyHeader}"
                               Style="{StaticResource SectionHeader}" Margin="0,20,0,8" Visibility="Collapsed"/>
                    <Border x:Name="VerifyCard" CornerRadius="8" Padding="16" Visibility="Collapsed"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="VerifyText" TextWrapping="Wrap" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: status and merge button -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.8"/>
                <Button x:Name="MergeButton" Grid.Column="1" Content="{svc:Loc MergeButton}"
                        Style="{DynamicResource AccentButtonStyle}" Padding="20,8"
                        IsEnabled="False" Click="Merge_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
